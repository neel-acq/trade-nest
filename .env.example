# PostgreSQL
POSTGRES_USER=tradenest
POSTGRES_PASSWORD=tradenest_secret
POSTGRES_DB=tradenest
DATABASE_URL=postgresql://tradenest:tradenest_secret@postgres:5432/tradenest
# Local (without Docker): postgresql://tradenest:tradenest_secret@localhost:5432/tradenest

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Backend
BACKEND_PORT=3001
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=http://localhost:3001
